# Server Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production
# In production, specify exact allowed origins separated by commas (wildcards are disallowed)
ALLOWED_ORIGINS=https://shashanktours.com,https://www.shashanktours.com
# Reverse proxy trust: 'loopback' for local Nginx/Caddy, false for direct standalone, or proxy IP/CIDR
TRUST_PROXY=loopback

# Admin Authentication (Change in production!)
JWT_SECRET=your_super_secret_jwt_random_key_here
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password_in_production

# Client API URL (leave blank if frontend & API are hosted on same domain)
# VITE_API_URL=https://api.yourdomain.com

# Optional External API Keys
GOOGLE_PLACES_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Official UPI Payment Configuration
# Provide the actual merchant UPI ID (e.g. shashankluck@axl, yourname@ybl, etc.)
VITE_UPI_ID=YOUR_ACTUAL_UPI_ID
VITE_MERCHANT_NAME=Shashank Tours & Travels
VITE_PAYMENT_PHONE=+91 87478 29020
